# Valeurs réservées au développement local ; remplace-les pour tout autre environnement.
POSTGRES_USER=kwatsur
POSTGRES_PASSWORD=kwatsur_dev
POSTGRES_DB=kwatsur
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kwatsur:kwatsur_dev@localhost:5432/kwatsur
# Port de l'interface sur la machine hôte (changer si 8000 est déjà pris).
API_PORT=8000
CORS_ORIGINS=http://localhost:8000
# Charge les annonces fictives au démarrage du conteneur.
SEED_DEMO_DATA=true

# --- Mode échantillon -----------------------------------------------------------
# true : fonctionne sans Zetaris, Nightshift ni Cloudflare (annonces fictives, règles
# sans IA, pas de génération d'images). À utiliser si un service est indisponible.
SAMPLE_MODE=false

# --- Source des annonces : postgres (base locale) ou zetaris -------------------
LISTING_SOURCE=postgres
ZETARIS_FALLBACK_TO_POSTGRES=true

# --- Zetaris (accès fournis par le hackathon) --------------------------------
# API REST documentée sur https://api.saas.enterprise.zetaris.com/redoc/index.html
ZETARIS_BASE_URL=
ZETARIS_API_KEY=
# Identifiant numérique de l'organisation (en-tête X-Org-ID).
ZETARIS_ORG_ID=
# Table enregistrée dans Zetaris à partir de scripts/export_listings_csv.py (ex. : schema.table).
ZETARIS_LISTINGS_TABLE=
# Rôle PostgreSQL en lecture seule par lequel Zetaris lit la vue zetaris_listings.
ZETARIS_PG_READER_PASSWORD=

# --- Modèle IA : nemotron (API NVIDIA), meterless (runtime local) ou none -----
# « rules » : mode démo sans clé (règles, sans IA). « meterless » : Nemotron via Nightshift.
LLM_PROVIDER=rules
LLM_TIMEOUT_SECONDS=60

# Clé obtenue sur https://build.nvidia.com (bouton « Get API Key »).
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Meterless Runtime : jeton lu dans <stateDir>/proxy-token ; modèles listés par GET /v1/models.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# URL utilisée depuis le conteneur Docker pour joindre le runtime sur l'hôte.
METERLESS_DOCKER_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_API_KEY=
# Épingler une route Nemotron listée par GET /v1/models (meterless/auto peut router ailleurs).
METERLESS_MODEL=meterless/auto
METERLESS_APP_ID=kwatsur

# --- Meterless Scout Intent : secret HMAC des contrats d'exécution -------------
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SCOUT_SIGNING_SECRET=

CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Images ---------------------------------------------------------------------
# Dossier des fichiers image (volume Docker /app/media) et taille maximale d'une photo.
MEDIA_DIRECTORY=media
IMAGE_UPLOAD_MAX_BYTES=5000000

# --- Génération d'images illustratives (docs/image-generation.md) ----------------
IMAGE_GENERATION_ENABLED=true
# Fournisseur : seul « cloudflare » existe pour l'instant.
IMAGE_GENERATION_PROVIDER=cloudflare
# Limite de Kwatsur (images générées par jour UTC), distincte du quota du fournisseur.
IMAGE_GENERATION_DAILY_LIMIT=2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Étapes de diffusion de FLUX.1 schnell (1 à 8, 4 par défaut).
CLOUDFLARE_IMAGE_STEPS=4
# Vision : décrire les vraies photos du propriétaire pour guider une illustration (même compte Cloudflare).
IMAGE_DESCRIPTION_ENABLED=true
CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
VISION_MAX_REFERENCE_PHOTOS=2

# --- Validation des annonces proposées par les propriétaires (page /admin.html) ---
# Jeton secret à saisir sur la page d'administration. Vide = administration fermée.
ADMIN_TOKEN=
